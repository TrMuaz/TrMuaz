------MultipartBoundary--OHjC1Km4UKMUPbXM9uAV8K6iIqS7NwzbUPS046DDHd----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-9dd2d989-a893-4bd9-bb92-070b9654a11c@mhtml.blink

@charset "utf-8";

:root { --ink: #20252b; --muted: #5c6873; --green: #176b55; --gold: #c6922e; --paper: #fff; --bg: #f2f5f3; --line: #dbe4df; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--ink); font-family: system-ui, -apple-system, "Segoe UI", Arial, sans-serif; line-height: 1.7; }

main { max-width: 780px; margin: auto; background: var(--paper); padding: 28px 24px 60px; box-shadow: rgba(23, 59, 42, 0.07) 0px 0px 24px; }

h1, h2, h3 { line-height: 1.25; color: var(--green); }

h1 { font-size: 2.25rem; margin: 0.2rem 0px 0.5rem; }

h2 { font-size: 1.55rem; margin: 2.2rem 0px 0.7rem; border-bottom: 2px solid var(--gold); padding-bottom: 0.25rem; }

h3 { font-size: 1.15rem; margin: 1.4rem 0px 0.3rem; }

p { margin: 0.65rem 0px; }

.lead { font-size: 1.12rem; color: rgb(57, 70, 75); }

.badge { display: inline-block; background: rgb(233, 243, 238); color: var(--green); border-radius: 999px; padding: 3px 11px; font-size: 0.82rem; font-weight: 700; }

.hero { border-radius: 14px; overflow: hidden; margin: 18px 0px 24px; }

.hero img { display: block; width: 100%; height: 220px; object-fit: cover; }

.caption { font-size: 0.8rem; color: var(--muted); padding: 5px 8px; background: rgb(250, 250, 250); }

.timeline { border-left: 4px solid var(--gold); padding-left: 18px; }

.event { margin: 1rem 0px; }

.event strong { color: var(--green); }

blockquote { margin: 1rem 0px; padding: 14px 17px; border-left: 5px solid var(--gold); background: rgb(251, 248, 238); border-radius: 0px 9px 9px 0px; }

blockquote.verse { font-size: 1.04rem; }

.arabic { font-family: Amiri, "Noto Naskh Arabic", "Traditional Arabic", serif; font-size: 1.55rem; line-height: 2.1; text-align: right; direction: rtl; margin: 0px 0px 10px; }

.translation { font-size: 1.04rem; }

.ref { display: block; margin-top: 7px; color: var(--green); font-weight: 700; font-size: 0.9rem; }

.hadith { background: rgb(238, 246, 242); border-left-color: var(--green); }

.note { background: rgb(246, 247, 247); border: 1px solid var(--line); padding: 12px 15px; border-radius: 9px; }

.key { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }

.key div { padding: 12px; background: rgb(247, 250, 248); border: 1px solid var(--line); border-radius: 9px; }

.key b { color: var(--green); }

img { max-width: 100%; }

footer { margin-top: 35px; padding-top: 15px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }

@media (max-width: 600px) {
  main { padding: 20px 15px; box-shadow: none; }
  h1 { font-size: 1.8rem; }
  .hero img { height: 165px; }
  .arabic { font-size: 1.3rem; }
  .key { grid-template-columns: 1fr; }
}

@media print {
  body { background: rgb(255, 255, 255); font-size: 10.5pt; }
  main { box-shadow: none; max-width: none; padding: 0px; }
  .hero img { height: 150px; }
  blockquote { break-inside: avoid; }
  h2 { break-after: avoid; }
  .no-print { display: none; }
}
